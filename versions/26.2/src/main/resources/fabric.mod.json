{
	"schemaVersion": 1,
	"id": "smoothhotbar",
	"version": "${version}",
	"name": "Smooth Hotbar",
	"description": "Smooth hotbar with a sliding selection, easing curves, a portal between slots 1 and 9 and smooth cooldowns.",
	"authors": [
		"Mel1x"
	],
	"contact": {
		"sources": "https://github.com/mel1x/SmoothHotbar",
		"issues": "https://github.com/mel1x/SmoothHotbar/issues"
	},
	"license": "MIT",
	"icon": "assets/smoothhotbar/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["mix.smoothhotbar.SmoothHotbarClient"],
		"modmenu": ["mix.smoothhotbar.integrations.ModMenuIntegration"]
	},
	"mixins": [
		"smoothhotbar.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": ">=26.2 <=26.2.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
